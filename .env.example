# Gemini API (free tier) — browser-side AI assistant
# Get a key at https://aistudio.google.com/apikey
# Optional: users can also paste their key in the app (stored in localStorage only).
VITE_GEMINI_API_KEY=""
# Recommended: newest first; app auto-fallbacks on quota errors
VITE_GEMINI_MODEL="gemini-3-flash"

# GEMINI_API_KEY: legacy name (optional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase App Check (recommended for production abuse protection).
# Public reCAPTCHA v3 site key only; never put the secret key in this file.
# Register the web app in Firebase Console > App Check before enabling enforcement.
VITE_FIREBASE_APP_CHECK_SITE_KEY=""
