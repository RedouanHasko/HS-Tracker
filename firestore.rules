rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isDocOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userEmail() {
      return (request.auth != null && request.auth.token != null && request.auth.token.email != null)
        ? request.auth.token.email.lower()
        : '';
    }

    // ID validation to guard against ID poisoning
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Helper to get safe string size
    function valString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // Entity validations
    function isValidUserProfile(data) {
      return data != null && ('fullName' in data ? valString(data.fullName, 200) : true);
    }

    function isValidRentalProperty(data) {
      return data is map
          && ('ownerName' in data ? valString(data.ownerName, 200) : true)
          && ('ownerEmail' in data ? valString(data.ownerEmail, 200) : true)
          && ('ownerPhone' in data ? valString(data.ownerPhone, 50) : true)
          && ('buildingNumber' in data ? valString(data.buildingNumber, 120) : true)
          && ('notes' in data ? valString(data.notes, 5000) : true)
          && ('pricePerNight' in data
            ? data.pricePerNight is number && data.pricePerNight >= 0 && data.pricePerNight <= 100000000
            : true)
          && ('commissionRate' in data
            ? data.commissionRate is number && data.commissionRate >= 0 && data.commissionRate <= 100
            : true)
          && ('monthlyCommissionRates' in data ? data.monthlyCommissionRates is map : true);
    }

    function isValidProject(data) {
      return data != null 
          && ('id' in data ? valString(data.id, 128) : true)
          && ('name' in data ? valString(data.name, 200) : true)
          && ('creatorEmail' in data ? valString(data.creatorEmail, 200) : true)
          && ('projectType' in data
            ? data.projectType == 'construction' || data.projectType == 'rental' || data.projectType == 'service'
            : true)
          && ('members' in data ? data.members is list && data.members.size() <= 100 : true)
          && ('memberEmails' in data
            ? data.memberEmails is list && data.memberEmails.size() <= 100
            : true)
          && ('invitedEmails' in data
            ? data.invitedEmails is list && data.invitedEmails.size() <= 100
            : true)
          && ('memberRoleByEmail' in data ? data.memberRoleByEmail is map : true)
          && ('sections' in data ? data.sections is list && data.sections.size() <= 500 : true)
          && ('expenses' in data ? data.expenses is list && data.expenses.size() <= 1000 : true)
          && ('tasks' in data ? data.tasks is list && data.tasks.size() <= 1000 : true)
          && ('documents' in data ? data.documents is list && data.documents.size() <= 500 : true)
          && ('photos' in data ? data.photos is list && data.photos.size() <= 500 : true)
          && ('rentalBookings' in data ? data.rentalBookings is list && data.rentalBookings.size() <= 1000 : true)
          && ('rentalOwnerPayments' in data ? data.rentalOwnerPayments is list && data.rentalOwnerPayments.size() <= 1000 : true)
          && ('storageVersion' in data ? data.storageVersion == 1 || data.storageVersion == 2 : true)
          && ('recordRevision' in data ? valString(data.recordRevision, 50) : true)
          && ('recordCounts' in data ? data.recordCounts is map : true)
          && ('rentalProperty' in data
            ? data.rentalProperty == null || isValidRentalProperty(data.rentalProperty)
            : true);
    }

    function isValidInvitation(data) {
      return data != null
          && ('id' in data ? valString(data.id, 128) : true)
          && ('projectId' in data ? valString(data.projectId, 128) : true)
          && ('projectName' in data ? valString(data.projectName, 200) : true)
          && ('ownerEmail' in data ? valString(data.ownerEmail, 200) : true)
          && ('inviteeEmail' in data ? valString(data.inviteeEmail, 200) : true)
          && ('status' in data
            ? data.status == 'pending' || data.status == 'accepted' || data.status == 'declined'
            : true)
          && ('role' in data
            ? data.role == 'read_only' || data.role == 'contributor' || data.role == 'editor'
              || data.role == 'manager' || data.role == 'co_owner'
            : true);
    }

    // Projects: accepted members only. Pending invitees read the invitation document.
    function isInvitedToProject(projectData) {
      return projectData != null
          && 'invitedEmails' in projectData
          && userEmail() in projectData.invitedEmails;
    }

    function isProjectMember(projectData) {
      return projectData != null && (
        ('creatorEmail' in projectData && projectData.creatorEmail.lower() == userEmail()) ||
        ('memberEmails' in projectData && userEmail() in projectData.memberEmails)
      );
    }

    function isProjectMemberById(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId));
      return project != null && isProjectMember(project.data);
    }

    // --- Role helpers (memberRoleByEmail denormalized on project save) ---
    function callerRole(projectData) {
      let email = userEmail();
      return projectData != null
          && 'creatorEmail' in projectData
          && projectData.creatorEmail.lower() == email
        ? 'owner'
        : projectData != null
            && 'memberRoleByEmail' in projectData
            && email in projectData.memberRoleByEmail
          ? projectData.memberRoleByEmail[email]
          : projectData != null
              && 'memberEmails' in projectData
              && email in projectData.memberEmails
            ? 'contributor'
            : 'read_only';
    }

    function roleLevel(role) {
      return role == 'owner' || role == 'co_owner' ? 4
        : role == 'manager' ? 3
        : role == 'editor' ? 2
        : role == 'contributor' ? 1
        : 0;
    }

    function ownerAccessPreserved() {
      let owner = resource.data.creatorEmail.lower();
      return request.resource.data.creatorEmail.lower() == owner
        && owner in request.resource.data.get('memberEmails', [])
        && owner in request.resource.data.get('memberRoleByEmail', {})
        && request.resource.data.get('memberRoleByEmail', {})[owner] == 'owner';
    }

    function projectSettingsUnchanged() {
      return request.resource.data.get('name', '') == resource.data.get('name', '')
        && request.resource.data.get('clientName', '') == resource.data.get('clientName', '')
        && request.resource.data.get('address', '') == resource.data.get('address', '')
        && request.resource.data.get('description', '') == resource.data.get('description', '')
        && request.resource.data.get('budget', 0) == resource.data.get('budget', 0)
        && request.resource.data.get('currency', 'DH') == resource.data.get('currency', 'DH')
        && request.resource.data.get('status', 'planning') == resource.data.get('status', 'planning')
        && request.resource.data.get('projectType', 'construction') == resource.data.get('projectType', 'construction')
        && request.resource.data.get('startDate', '') == resource.data.get('startDate', '')
        && request.resource.data.get('estimatedEndDate', '') == resource.data.get('estimatedEndDate', '');
    }

    function reimbursementsUnchanged() {
      return request.resource.data.get('reimbursements', []) == resource.data.get('reimbursements', []);
    }

    function rentalSettingsUnchanged() {
      return request.resource.data.get('rentalProperty', {}) == resource.data.get('rentalProperty', {});
    }

    function membersArrayUnchanged() {
      return request.resource.data.get('members', []) == resource.data.get('members', []);
    }

    function isContributorContentPatch() {
      let patchKeys = request.resource.data.diff(resource.data).affectedKeys();
      return membersArrayUnchanged()
          && projectSettingsUnchanged()
          && reimbursementsUnchanged()
          && rentalSettingsUnchanged()
          && (
            patchKeys.hasOnly(['expenses'])
            || patchKeys.hasOnly(['tasks'])
            || patchKeys.hasOnly(['photos'])
            || patchKeys.hasOnly(['documents'])
            || patchKeys.hasOnly(['sections'])
            || patchKeys.hasOnly(['rentalBookings'])
            || patchKeys.hasOnly(['expenses', 'tasks'])
            || patchKeys.hasOnly(['expenses', 'rentalBookings'])
          );
    }

    function isVersionedRecordHeartbeatPatch() {
      let patchKeys = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.get('storageVersion', 1) == 2
          && request.resource.data.get('storageVersion', 1) == 2
          && membersArrayUnchanged()
          && projectSettingsUnchanged()
          && reimbursementsUnchanged()
          && rentalSettingsUnchanged()
          && patchKeys.hasOnly(['recordRevision', 'recordCounts']);
    }

    function isAcceptedProjectMember(projectData) {
      return projectData != null && (
        ('creatorEmail' in projectData && projectData.creatorEmail.lower() == userEmail()) ||
        ('memberEmails' in projectData && userEmail() in projectData.memberEmails)
      );
    }

    function isAcceptedMemberByProjectId(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId));
      return project != null && isAcceptedProjectMember(project.data);
    }

    function isAdminRole(role) {
      return role == 'owner' || role == 'co_owner' || role == 'manager';
    }

    // Pending invitee accepting or declining — may update members + access lists only.
    // The app writes a surgical updateDoc with exactly the keys below (never the role
    // map, never recordRevision/records), so both accept and decline stay provable here.
    function inviteePatchKeys(patchKeys) {
      return (patchKeys.hasAll(['members', 'memberEmails', 'invitedEmails']) && patchKeys.size() == 3)
          || (patchKeys.hasAll(['members', 'invitedEmails']) && patchKeys.size() == 2)
          || patchKeys.hasOnly(['members', 'memberEmails', 'memberRoleByEmail', 'invitedEmails'])
          || patchKeys.hasOnly(['members', 'memberRoleByEmail', 'invitedEmails']);
    }

    function isInviteeMembershipPatch() {
      let patchKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isInvitedToProject(resource.data)
          && request.resource.data.get('memberRoleByEmail', {})
            == resource.data.get('memberRoleByEmail', {})
          && !(userEmail() in request.resource.data.get('invitedEmails', []))
          && (
            userEmail() in request.resource.data.get('memberEmails', [])
            || request.resource.data.get('memberEmails', [])
              == resource.data.get('memberEmails', [])
          )
          && inviteePatchKeys(patchKeys);
    }

    function canUpdateProjectByRole() {
      let role = callerRole(resource.data);
      let level = roleLevel(role);
      return isAdminRole(role)
        || isInviteeMembershipPatch()
        || (
          level >= 1
          && (
            (
              resource.data.get('storageVersion', 1) == 2
              && isVersionedRecordHeartbeatPatch()
            )
            || (
              resource.data.get('storageVersion', 1) != 2
              && isContributorContentPatch()
            )
          )
        );
    }

    function storageVersionTransitionAllowed() {
      return request.resource.data.get('storageVersion', 1)
            == resource.data.get('storageVersion', 1)
        || (
          resource.data.get('storageVersion', 1) != 2
          && request.resource.data.get('storageVersion', 1) == 2
          && resource.data.creatorEmail.lower() == userEmail()
        );
    }

    function callerRoleByProjectId(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId));
      return project != null ? callerRole(project.data) : 'read_only';
    }

    function canWriteTaskMedia(projectId) {
      return roleLevel(callerRoleByProjectId(projectId)) >= 1;
    }

    function callerRoleByProjectIdAfter(projectId) {
      let project = getAfter(/databases/$(database)/documents/projects/$(projectId));
      return project != null ? callerRole(project.data) : 'read_only';
    }

    function isValidProjectRecord(data, projectId) {
      return data is map
          && data.projectId == projectId
          && valString(data.entityId, 128)
          && data.kind in [
            'section',
            'expense',
            'task',
            'photo',
            'document',
            'reimbursement',
            'rental_booking',
            'rental_owner_payment',
            'rental_calendar_block',
            'rental_owner_statement',
            'contact',
            'construction_funding',
            'construction_change_order',
            'construction_purchase_order',
            'construction_site_log',
            'construction_budget_commitment'
          ]
          && data.payload is map
          && valString(data.updatedAt, 50)
          && valString(data.updatedBy, 200)
          && data.updatedBy.lower() == userEmail();
    }

    function contributorCanWriteRecordKind(kind) {
      return kind in [
        'section',
        'expense',
        'task',
        'photo',
        'document',
        'rental_booking',
        'rental_calendar_block',
        'contact',
        'construction_change_order',
        'construction_site_log'
      ];
    }

    function canWriteProjectRecord(projectId, recordData) {
      let role = callerRoleByProjectIdAfter(projectId);
      return isAdminRole(role)
          || (roleLevel(role) >= 1 && contributorCanWriteRecordKind(recordData.kind));
    }

    function canDeleteProjectRecord(projectId, recordData) {
      let role = callerRoleByProjectId(projectId);
      return isAdminRole(role)
          || (roleLevel(role) >= 1 && contributorCanWriteRecordKind(recordData.kind));
    }

    function isValidProjectTrash(data, projectId) {
      return data is map
          && data.projectId == projectId
          && valString(data.entityId, 128)
          && data.kind in [
            'section',
            'expense',
            'task',
            'photo',
            'document',
            'reimbursement',
            'rental_booking',
            'rental_owner_payment',
            'rental_calendar_block',
            'rental_owner_statement',
            'contact',
            'construction_funding',
            'construction_change_order',
            'construction_purchase_order',
            'construction_site_log',
            'construction_budget_commitment'
          ]
          && data.payload is map
          && valString(data.updatedAt, 50)
          && valString(data.updatedBy, 200)
          && valString(data.deletedAt, 50)
          && valString(data.deletedBy, 200)
          && data.deletedBy.lower() == userEmail();
    }

    function isValidGeneratedDocument(data, projectId) {
      return data is map
          && data.projectId == projectId
          && valString(data.id, 128)
          && valString(data.number, 80)
          && data.kind in ['invoice', 'voucher', 'receipt']
          && data.status in ['draft', 'finalized', 'paid', 'cancelled']
          && data.version is int && data.version >= 1 && data.version <= 10000
          && data.items is list && data.items.size() > 0 && data.items.size() <= 200
          && data.visibleColumns is list && data.visibleColumns.size() <= 3
          && data.taxRate is number && data.taxRate >= 0 && data.taxRate <= 100
          && data.subtotal is number && data.subtotal >= 0
          && data.total is number && data.total >= 0
          && valString(data.createdAt, 50)
          && valString(data.createdBy, 200)
          && valString(data.updatedAt, 50)
          && valString(data.updatedBy, 200)
          && data.updatedBy.lower() == userEmail();
    }

    function isValidDocumentCounter(data, projectId) {
      return data is map
          && data.projectId == projectId
          && data.kind in ['invoice', 'voucher', 'receipt']
          && data.year is int && data.year >= 2000 && data.year <= 2200
          && data.nextNumber is int && data.nextNumber >= 1
          && valString(data.updatedAt, 50)
          && valString(data.updatedBy, 200)
          && data.updatedBy.lower() == userEmail();
    }

    function isValidAIUndoEntry(data, projectId) {
      return data is map
          && data.projectId == projectId
          && valString(data.id, 128)
          && valString(data.createdAt, 50)
          && valString(data.createdBy, 200)
          && data.createdBy.lower() == userEmail()
          && data.previousRootValues is map
          && data.missingRootKeys is list && data.missingRootKeys.size() <= 50
          && data.recordChanges is list && data.recordChanges.size() <= 100
          && (data.previousRootValues.size() > 0
              || data.missingRootKeys.size() > 0
              || data.recordChanges.size() > 0);
    }

    // Invitations: owner or target invitee
    function isInvitationParty(inviteData) {
      return inviteData != null && (
        ('ownerEmail' in inviteData && inviteData.ownerEmail.lower() == userEmail()) ||
        ('inviteeEmail' in inviteData && inviteData.inviteeEmail.lower() == userEmail())
      );
    }

    // --- COLLECTION RULES ---

    // 1. User Profiles
    match /user_profiles/{userId} {
      allow read: if isSignedIn();
      allow create: if isDocOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isDocOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if false;
    }

    // 2. Projects
    match /projects/{projectId} {
      // Invite acceptance needs one direct read by known project ID. Queries stay member-only.
      allow get: if isSignedIn()
          && (isProjectMember(resource.data) || isInvitedToProject(resource.data));
      allow list: if isSignedIn() && isProjectMember(resource.data);
      
      allow create: if isSignedIn() && isValidId(projectId) 
          && request.resource.data.creatorEmail.lower() == userEmail()
          && (userEmail() in request.resource.data.memberEmails)
          && request.resource.data.memberRoleByEmail[userEmail()] == 'owner'
          && isValidProject(request.resource.data);
          
      allow update: if isSignedIn()
          && (isProjectMember(resource.data) || isInvitedToProject(resource.data))
          && request.resource.data.creatorEmail.lower() == resource.data.creatorEmail.lower()
          && isValidProject(request.resource.data)
          && ownerAccessPreserved()
          && storageVersionTransitionAllowed()
          && canUpdateProjectByRole();
          
      allow delete: if isSignedIn() && resource.data.creatorEmail.lower() == userEmail();

      match /records/{recordId} {
        allow read: if isSignedIn() && isAcceptedMemberByProjectId(projectId);
        allow create: if isSignedIn()
            && valString(recordId, 300)
            && isValidProjectRecord(request.resource.data, projectId)
            && canWriteProjectRecord(projectId, request.resource.data);
        allow update: if isSignedIn()
            && isValidProjectRecord(request.resource.data, projectId)
            && request.resource.data.projectId == resource.data.projectId
            && request.resource.data.kind == resource.data.kind
            && request.resource.data.entityId == resource.data.entityId
            && canWriteProjectRecord(projectId, request.resource.data);
        allow delete: if isSignedIn()
            && canDeleteProjectRecord(projectId, resource.data);
      }

      match /trash/{trashId} {
        allow read: if isSignedIn() && isAcceptedMemberByProjectId(projectId);
        allow create: if isSignedIn()
            && valString(trashId, 300)
            && isValidProjectTrash(request.resource.data, projectId)
            && canWriteProjectRecord(projectId, request.resource.data);
        allow update: if false;
        allow delete: if isSignedIn()
            && isAdminRole(callerRoleByProjectId(projectId));
      }

      match /generated_documents/{documentId} {
        allow read: if isSignedIn() && isAcceptedMemberByProjectId(projectId);
        allow create: if isSignedIn()
            && isValidId(documentId)
            && isValidGeneratedDocument(request.resource.data, projectId)
            && roleLevel(callerRoleByProjectIdAfter(projectId)) >= 1;
        allow update: if isSignedIn()
            && isValidGeneratedDocument(request.resource.data, projectId)
            && request.resource.data.id == resource.data.id
            && request.resource.data.projectId == resource.data.projectId
            && request.resource.data.kind == resource.data.kind
            && request.resource.data.number == resource.data.number
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.version == resource.data.version + 1
            && roleLevel(callerRoleByProjectIdAfter(projectId)) >= 1;
        allow delete: if false;
      }

      match /document_counters/{counterId} {
        allow read: if isSignedIn() && isAcceptedMemberByProjectId(projectId);
        allow create: if isSignedIn()
            && isValidId(counterId)
            && isValidDocumentCounter(request.resource.data, projectId)
            && request.resource.data.nextNumber == 1
            && roleLevel(callerRoleByProjectIdAfter(projectId)) >= 1;
        allow update: if isSignedIn()
            && isValidDocumentCounter(request.resource.data, projectId)
            && request.resource.data.projectId == resource.data.projectId
            && request.resource.data.kind == resource.data.kind
            && request.resource.data.year == resource.data.year
            && request.resource.data.nextNumber == resource.data.nextNumber + 1
            && roleLevel(callerRoleByProjectIdAfter(projectId)) >= 1;
        allow delete: if false;
      }

      match /ai_undo/{entryId} {
        allow read: if isSignedIn() && isAcceptedMemberByProjectId(projectId);
        allow create: if isSignedIn()
            && isValidId(entryId)
            && isValidAIUndoEntry(request.resource.data, projectId)
            && request.resource.data.id == entryId
            && roleLevel(callerRoleByProjectIdAfter(projectId)) >= 1;
        allow update: if false;
        allow delete: if isSignedIn()
            && isAcceptedMemberByProjectId(projectId)
            && (resource.data.createdBy.lower() == userEmail()
                || isAdminRole(callerRoleByProjectId(projectId)));
      }
    }

    // 3. Invitations
    match /invitations/{invitationId} {
      allow get: if isSignedIn() && (resource == null || isInvitationParty(resource.data));
      allow list: if isSignedIn() && (resource == null || ('inviteeEmail' in resource.data && resource.data.inviteeEmail.lower() == userEmail()));
      
      allow create: if isSignedIn() && isValidId(invitationId)
          && request.resource.data.ownerEmail.lower() == userEmail()
          && isAdminRole(callerRoleByProjectId(request.resource.data.projectId))
          && isValidInvitation(request.resource.data);
          
      allow update: if isSignedIn() && (
        (resource.data.ownerEmail.lower() == userEmail() && isValidInvitation(request.resource.data)) ||
        (resource.data.inviteeEmail.lower() == userEmail() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
      
      allow delete: if isSignedIn() && resource.data.ownerEmail.lower() == userEmail();
    }

    // 4. Timeline Activities — memberEmails denormalized for secure list queries
    match /activities/{activityId} {
      function canReadActivity() {
        return isSignedIn()
          && resource != null
          && (
            ('memberEmails' in resource.data && userEmail() in resource.data.memberEmails)
            || isProjectMemberById(resource.data.projectId)
          );
      }

      allow get: if canReadActivity();
      allow list: if isSignedIn()
        && resource != null
        && ('memberEmails' in resource.data)
        && userEmail() in resource.data.memberEmails;

      allow create: if isSignedIn() && isValidId(activityId)
        && isProjectMemberById(request.resource.data.projectId)
        && roleLevel(callerRoleByProjectId(request.resource.data.projectId)) >= 1
        && request.resource.data.userEmail.lower() == userEmail()
        && ('memberEmails' in request.resource.data)
        && request.resource.data.memberEmails is list
        && request.resource.data.memberEmails
          == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.memberEmails;

      allow update, delete: if false;
    }

    // 5. User private nested paths (Notifications, Submissions, private profile)
    match /users/{userId}/{document=**} {
      allow read, write: if isDocOwner(userId);
    }

    // 6. Task media files (Spark plan — compressed images stored outside project doc)
    match /project_task_media/{mediaId} {
      allow read: if isSignedIn() && isAcceptedMemberByProjectId(resource.data.projectId);
      allow create: if isSignedIn()
        && isValidId(mediaId)
        && request.resource.data.projectId is string
        && request.resource.data.taskId is string
        && request.resource.data.category in ['before', 'after', 'progress', 'attachments', 'expense_receipt', 'project_gallery']
        && request.resource.data.mimeType is string
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 750000
        && isAcceptedMemberByProjectId(request.resource.data.projectId)
        && canWriteTaskMedia(request.resource.data.projectId)
        && (
          !('sizeBytes' in request.resource.data)
          || (
            request.resource.data.sizeBytes is number
            && request.resource.data.sizeBytes > 0
            && request.resource.data.sizeBytes < 200000
          )
        );
      allow delete: if isSignedIn()
        && isAcceptedMemberByProjectId(resource.data.projectId)
        && canWriteTaskMedia(resource.data.projectId);
    }
  }
}
